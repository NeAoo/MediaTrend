# ==================== 大模型密钥 ====================
# 业务打分配置在 config.yaml 的 scoring 节；API Key 属于密钥，只放 .env。
LLM_API_KEY=

# ==================== 配置文件 ====================
# 可选：使用非默认配置文件。通常保留 config.yaml 即可。
AI_TREND_CONFIG=config.yaml

# ==================== 可选 Cookie 登录 ====================
# 默认推荐 qrcode 登录；只有 config.yaml 中把对应平台 login_type 改为 cookie 时才需要填写。
SOGOU_WECHAT_COOKIE=
XIAOHONGSHU_COOKIE=
ZHIHU_COOKIE=
GOOGLE_NEWS_PROXY_URL=
TREND_CRAWLER_RUNTIME_PYTHON_BIN=

# ==================== CimiData 全网热榜 ====================
CIMIDATA_HOST=https://api.cimidata.com
CIMIDATA_APP_ID=
CIMIDATA_APP_SECRET=

# ==================== 日志 ====================
LOG_LEVEL=INFO
LOG_FILE=./logs/agent.log
LOG_ROTATION=00:00
LOG_RETENTION=30 days
LOG_COMPRESSION=
