# ==================== 大模型配置 ====================
# `python main.py run` 需要填写；只跑 `python main.py search` 可先留空
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5.5
# 单次 AI 打分请求超时时间，避免接口或代理卡死
LLM_TIMEOUT_SECONDS=120
# AI 请求失败后的重试次数；本任务每天定时跑，建议不要太高
LLM_MAX_RETRIES=1
# 默认留空，使用接口默认输出上限；需要强制限制时再填写数字
LLM_MAX_COMPLETION_TOKENS=
# 默认留空，使用接口默认推理强度；需要强制设置时可填 minimal/low/medium/high
LLM_REASONING_EFFORT=
# AI 打分并发线程数；每篇文章单独打分，默认同时跑 5 篇
SCORE_WORKERS=5
# AI 返回内容不是合法 JSON 时给的低分，避免无效评分进入候选池
SCORING_PARSE_FAILURE_SCORE=1
# 如果所有文章都解析失败，说明 API/模型整体不可用；随机抽取 TOP_N_SELECT_COUNT 篇继续上传
SCORING_RANDOM_FALLBACK_ON_ALL_PARSE_FAILURES=true

# ==================== 本地第一次运行建议 ====================
# 推荐先只跑 wechat，确认链路正常后再改成 wechat,xiaohongshu,zhihu,general
ENABLED_SOURCES=wechat
INITIAL_COLLECT_COUNT=30
TOP_N_SELECT_COUNT=10
TIME_RANGE_MIN=0
TIME_RANGE_MAX=24

# ==================== 微信公众号（搜狗微信搜索）====================
WECHAT_SEARCH_KEYWORDS=教育改革,中考
SOGOU_WECHAT_COOKIE=
WECHAT_MAX_RESULTS_PER_KEYWORD=8
WECHAT_USE_PLAYWRIGHT=true
WECHAT_FETCH_DETAIL_PAGE=false

# 微信公众平台后台：按固定公众号名称抓取最近文章，需要你自己的公众号后台扫码登录
WECHAT_MP_ACCOUNTS=中国教育报,人民教育
WECHAT_MP_MAX_ARTICLES_PER_ACCOUNT=10
WECHAT_MP_LOOKBACK_DAYS=7
WECHAT_MP_LOGIN_TIMEOUT_SECONDS=180
WECHAT_MP_HEADLESS=false
WECHAT_MP_FETCH_DETAIL_PAGE=true
WECHAT_MP_SLOW_MO_MS=300
WECHAT_MP_ACTION_DELAY_SECONDS=1.5
WECHAT_MP_ARTICLE_DELAY_SECONDS=3
WECHAT_MP_PAGE_DELAY_SECONDS=4
WECHAT_MP_ACCOUNT_DELAY_SECONDS=8
WECHAT_MP_RAW_OUTPUT_DIR=./raw_data/wechat_mp
WECHAT_MP_STORAGE_STATE=./browser_data/wechat_mp_state.json

# ==================== TrendCrawlerRuntime（小红书 / 知乎）====================
# 默认就是当前仓库里的 TrendCrawlerRuntime 目录，通常不用改
TREND_CRAWLER_RUNTIME_DIR=./TrendCrawlerRuntime
# 默认复用当前虚拟环境 Python，只有特殊情况才需要改
TREND_CRAWLER_RUNTIME_PYTHON_BIN=
TREND_CRAWLER_RUNTIME_MAX_NOTES_COUNT=20
TREND_CRAWLER_RUNTIME_TIMEOUT_SECONDS=900
TREND_CRAWLER_RUNTIME_LOGIN_TYPE=qrcode

XIAOHONGSHU_LOGIN_TYPE=qrcode
XIAOHONGSHU_SEARCH_KEYWORDS=教育改革,中考
XIAOHONGSHU_MAX_RESULTS_PER_KEYWORD=20
XIAOHONGSHU_COOKIE=

ZHIHU_LOGIN_TYPE=qrcode
ZHIHU_SEARCH_KEYWORDS=教育改革,中考
ZHIHU_MAX_RESULTS_PER_KEYWORD=20
ZHIHU_COOKIE=

# ==================== 通用教育资讯站点 ====================
GENERAL_SEARCH_KEYWORDS=教育改革,中考
GENERAL_MAX_LINKS_PER_SITE=30

# ==================== 输出与调度 ====================
OUTPUT_DIR=./output
SCHEDULE_TIME=08:00

# ==================== longxia 候选投放 ====================
# 是否在 `python main.py run` 后额外生成 longxia 可读取的候选 md
LONGXIA_CANDIDATE_EXPORT_ENABLED=true
# 本地候选 md 输出目录；每天会生成一个 YYYY-MM-DD 子目录
LONGXIA_CANDIDATE_EXPORT_DIR=./output/longxia_trend_candidates
# 每篇候选 md 的正文最多保留多少字，超过则截断
LONGXIA_CANDIDATE_CONTENT_MAX_CHARS=5000
# 候选日期使用的时区；要和 longxia 当天目录保持一致
LONGXIA_CANDIDATE_TIMEZONE=Asia/Shanghai
# 本机 ssh config 里的 longxia Host 名称
LONGXIA_SSH_TARGET=longxia
# longxia 侧人工候选根目录；脚本会自动追加 YYYY-MM-DD 子目录
LONGXIA_REMOTE_CANDIDATE_ROOT=/home/admin/neo/auto_gongzhonghao/edu_renjiao/research/trend_candidates
