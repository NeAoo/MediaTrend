# ==================== 大模型配置 ====================
# `python main.py run` 需要填写；只跑 `python main.py search` 可先留空。
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5.4
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=1
LLM_MAX_COMPLETION_TOKENS=
LLM_REASONING_EFFORT=
SCORE_WORKERS=5
SCORING_PARSE_FAILURE_SCORE=1
SCORING_RANDOM_FALLBACK_ON_ALL_PARSE_FAILURES=true

# ==================== 配置文件 ====================
# 可选：使用非默认配置文件。通常保留 config.yaml 即可。
AI_TREND_CONFIG=config.yaml

# ==================== 可选 Cookie 登录 ====================
# 默认推荐 qrcode 登录；只有 config.yaml 中把对应平台 login_type 改为 cookie 时才需要填写。
SOGOU_WECHAT_COOKIE=
XIAOHONGSHU_COOKIE=
ZHIHU_COOKIE=
GOOGLE_NEWS_PROXY_URL=
MEDIA_CRAWLER_PYTHON_BIN=

# ==================== 日志 ====================
LOG_LEVEL=INFO
LOG_FILE=./logs/agent.log
LOG_ROTATION=00:00
LOG_RETENTION=30 days
LOG_COMPRESSION=
