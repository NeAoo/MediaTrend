# ==================== 大模型 API 配置 ====================
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4

# ==================== 输出配置 ====================
OUTPUT_DIR=./output


# ==================== 搜索配置 ====================
# 目前是小红书和知乎是：第一次扫码登陆
# ==================== 小红书配置（可选）====================
# 从浏览器获取 Cookie 后填写
XIAOHONGSHU_COOKIE=

# ==================== 知乎配置（可选）====================
ZHIHU_COOKIE=

# ==================== 微信公众号配置（可选）====================
# 搜狗微信搜索通常不需要 Cookie，但如有需要可在此配置
WECHAT_COOKIE=